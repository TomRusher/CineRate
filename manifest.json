{
  "manifest_version": 3,
  "name": "CineRate",
  "version": "1.0",
  "description": "Ukazuje hodnocení z ČSFD a IMDb na stránkách Cinema City.",
  "host_permissions": [
    "https://www.csfd.cz/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.cinemacity.cz/*"],
      "js": ["content.js"]
    }
  ]
}
